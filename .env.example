# Copy this file to .env.local and fill in your Firebase project credentials.
# For CI/CD, add each variable as a GitHub repository secret (Settings → Secrets → Actions).
# Get these values from: https://console.firebase.google.com → Project Settings → Your apps

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
